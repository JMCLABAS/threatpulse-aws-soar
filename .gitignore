# === TERRAFORM (CRÍTICO EN SEGURIDAD) ===
# Descargas locales de providers (son binarios de cientos de MB)
**/.terraform/*
# El tfstate contiene ARNs, metadatos de red y a veces secretos en texto claro
*.tfstate
*.tfstate.*
# Archivo temporal de bloqueo de estado local (por si un apply se corta a medias)
.terraform.tfstate.lock.info
# Logs de fallo y archivos de plan binario (pueden incluir valores sensibles)
crash.log
crash.*.log
*.tfplan
# Variables locales con posibles configuraciones privadas (sí subimos *.tfvars.example)
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# === PYTHON & ARTEFACTOS DE LAMBDA ===
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
# Paquetes zip temporales generados al desplegar Lambdas
*.zip

# === SECRETOS Y ENTORNO LOCAL ===
.env
.env.*
!.env.example
*.pem
*.key

# === EDITORES Y SISTEMA OPERATIVO ===
.vscode/
.idea/
.DS_Store
Thumbs.db